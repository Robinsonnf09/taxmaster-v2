<script type="text/javascript">
	(function($) {
		$(function(){
			var captcha = $.saj.getUrlParameter('uuidCaptcha');
			if(!captcha){
				return;
			}
			$('.incidente a').each(function(){
				var $incidente = $(this);
				var url = $incidente.attr('href');
				$incidente.attr('href', url+'&uuidCaptcha='+captcha);
			});
		})
	})(jQuery);
</script>











