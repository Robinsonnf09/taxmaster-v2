<div id="modalTokenDuploFator">
    <h2 class="loginHeading">
        Validação de identificação
    </h2>
    <div id="txtEnvio">
        <p class="txt-envio-span">Insira o código de validação enviado para seu endereço de e-mail principal <b></b> e seus e-mails alternativos cadastrados no Portal.</p>
    </div>
    <div id="inputToken" class="input-token-div">
        <label for="tokenInformado">Código*</label>
        <input class="loginInput" type="text" required maxlength="6" oninput="verificarCaracteres(this)" class="input-token" id="tokenInformado" name="tokenInformado">
        <div id="contadorRegressivo" class="contador-regressivo" style="display:none"></div>
        <div id="contadorRegressivoSR" class="sr-only" aria-live="polite" aria-atomic="true"></div>
        <div id="avisoTokenInvalido" class="aviso-token-invalido" style="display: none">
            
        </div>
    </div>
    <div class="btn-group-sm text-left">
        <button id="btnEnviarToken" type="submit" class="spwBotaoDefault" >
            Enviar
        </button>
        <button id="btnReceberToken" type="submit" onclick="inicializaContador()" class="spwBotao newCodeBtn" >
            Receber novo código
        </button>
        <input type="hidden" value="">
    </div>
