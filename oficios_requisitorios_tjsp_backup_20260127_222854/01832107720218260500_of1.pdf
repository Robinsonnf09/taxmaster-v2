<form name="consultarProcessoForm" method="GET" action="/cposgcr/search.do" autocomplete="off" enctype="" onsubmit="return applySubmit(this, eval('function spwSubmit(t, e){decodificaInputMulSelOnSubmit();if (!IS_enableSubmit) return false; return BENV_isCamposValidos(t); } spwSubmit(this, event);'));" id="formularioConsulta" target="">
	<input type="hidden" name="conversationId" value="">

	<section class="form__consultar-processos">
				

				<input type="hidden" name="paginaConsulta" value="0">

				<div class="form__consultar-processos__item form__consultar-processos__item--consultar">
					<div class="form-group">
						<label for="cbPesquisa" class="unj-label unj-label--required">Consultar por</label>
                        









 	<select name="cbPesquisa" class="form-control" id="cbPesquisa"><option value="NUMPROC">Número do Processo</option>
		
	 		<option value="NMPARTE">Nome da parte</option>
		
	 		<option value="DOCPARTE">Documento da Parte</option>
		
	 		<option value="NMADVOGADO">Nome do Advogado</option>
		
	 		<option value="NUMOAB">OAB</option></select>

                    </div>
                </div> <!-- //form__consultar-processos__item--consultar -->



                <div class="form__consultar-processos__item form__consultar-processos__item--tipo-de-consulta">
                    <div class="form-group">
                        
								<div id="NUMPROC">
								
									
										




































	
	
		
	
	
		
	

	

	
	
		<script>$.saj.numeroProcesso.desabilitarNumeroOculto = false;</script>
	
	
		
	

	<script type="text/javascript">
		(function($){
			$(function() {
                //remove comportamento de exibir mensagem de erro típica do html5
                $('form:visible').attr('novalidate', '');

                var camposNumeroProcesso = $('[name="numeroDigitoAnoUnificado"], [name="foroNumeroUnificado"], [id^="JTRNumeroUnificado"], #nuProcessoAntigoFormatado');
                camposNumeroProcesso.addClass('form-control-nuProcesso');
                camposNumeroProcesso.removeAttr('onkeypress onblur onkeydown onmousemove onmouseout onmouseover onfocus');

				if($.browser.msie){
					$('.grupoRadio').find('input:radio:visible:enabled').attr('aria-required','');
					return;
				}
				$('.grupoRadio').attr('aria-required','').attr('required','');
			});
		})(jQuery);
	</script>

	<style>
		/* remove borda vermelha de elementos required */
		input:invalid {
			box-shadow: none;
		}
		[name="numeroDigitoAnoUnificado"] {
			width: 130px;
		}
		#JTRNumeroUnificado {
			width: 50px;
		}
		[name="foroNumeroUnificado"] {
			width: 60px;
		}
	</style>


<div id="interna_NUMPROC" style="float:left">
	<span id="linhaProcessoUnificado">
		








	


	
	
	
	
	
	






 
<input type="text" name="numeroDigitoAnoUnificado" maxlength="25" size="20" value="" formatType="TEXT" onkeypress="CT_KPS(this, event);" onblur="CT_BLR(this);" onkeydown="CT_KDN(this, event);" onmousemove="CT_MMOV(this, event);" onmouseout="CT_MOUT(this, event);" onmouseover="CT_MOV(this, event);" onfocus="C_OFC(this, event);" id="numeroDigitoAnoUnificado">
<input type="text" id="JTRNumeroUnificado" size="3" disabled="disabled" value="8.26"/>
<input type="text" name="foroNumeroUnificado" maxlength="4" size="3" value="" formatType="TEXT" onkeypress="CT_KPS(this, event);" onblur="CT_BLR(this);" onkeydown="CT_KDN(this, event);" onmousemove="CT_MMOV(this, event);" onmouseout="CT_MOUT(this, event);" onmouseover="CT_MOV(this, event);" onfocus="C_OFC(this, event);" id="foroNumeroUnificado">
<input type="hidden" name="dePesquisaNuUnificado" value="" id="nuProcessoUnificadoFormatado">

	<input type="hidden" name="dePesquisaNuUnificado" value="UNIFICADO" id="tipoNumero">


<script>
	(function($){
		$(function() {
			var saj = $.saj;
			var mascaraNumeroUnificado = saj.mascaraNumeroUnificado;
			var $campoNumeroDigitoAnoUnificado = $('#numeroDigitoAnoUnificado');
			var $campoForoNumeroUnificado = $('#foroNumeroUnificado');
			
				
				
					saj.configurarMascaraInput($campoForoNumeroUnificado, '0000');
				
			
			saj.configurarMascaraInput($campoNumeroDigitoAnoUnificado, mascaraNumeroUnificado, $campoForoNumeroUnificado,{
				afterPaste: afterPaste			
			});
			saj.bindCamposNumeroProcesso('');
			
		});		
		
		var afterPaste = function(textoOriginal) {
			var texto = getDigits(textoOriginal);
			if (!texto || texto.length < 16) {
				return;
			}
			
			var jtr = $('#JTRNumeroUnificado').val();
			jtr = getDigits(jtr);
			var jtrDigitado = texto.substring(13,16);
			var foroUnificado;
			//pega os 4 ultimos digitos, e caso o jtr colado for o mesmo, coloca os 4 no campo de foro unificado
			//se o jtr for diferente nao coloca nada no campo de foro unificado
			if (jtr == jtrDigitado) {
				foroUnificado = texto.substring(16,texto.length);
			} else {
				foroUnificado = '';
			}
			
			var numeroDigitoAno = texto.substring(0,13);
			var $numeroDigitoAno = $('#numeroDigitoAnoUnificado');
			$numeroDigitoAno.val(numeroDigitoAno);
			
			var $foroNumeroUnificado = $('#foroNumeroUnificado');
			$foroNumeroUnificado.val(foroUnificado);
			$foroNumeroUnificado.trigger('blur');
			$foroNumeroUnificado.focus();
		};
		
		var getDigits = function(texto) {
			return texto.replace(/[^0-9]/g, '');
		};
		$('#numeroDigitoAnoUnificado').attr('aria-label','Número do processo. Informe os treze primeiros dígitos do número do processo.');
		$('#foroNumeroUnificado').attr('aria-label','Informe os quatro últimos dígitos do número do processo.');
	})(jQuery);
	
</script>

	</span>
	
		
		
